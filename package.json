{
  "name": "vocab-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "expo": "~57.0.30",
    "expo-constants": "~57.0.21",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.58.0",
    "papaparse": "^5.7.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \".github/**/*.yml\" \"*.{js,json,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \".github/**/*.yml\" \"*.{js,json,ts}\"",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:data && npm run test:task && npm run test:navigation",
    "test:coverage": "node --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --import tsx --test tests/data.test.ts tests/taskReducer.test.ts tests/navigationLock.test.ts tests/fitWordText.test.ts tests/accessibility.test.ts tests/observability.test.ts",
    "test:data": "tsx --test tests/data.test.ts",
    "test:task": "tsx --test tests/taskReducer.test.ts tests/fitWordText.test.ts tests/accessibility.test.ts tests/observability.test.ts",
    "test:navigation": "tsx --test tests/navigationLock.test.ts",
    "doctor": "npx --yes expo-doctor@latest",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test:coverage && npm run doctor",
    "perf:budget": "node scripts/performance-budget.mjs",
    "check:release": "npm run check && npx expo export --platform android --output-dir .expo/check && npm run perf:budget"
  },
  "private": true
}
