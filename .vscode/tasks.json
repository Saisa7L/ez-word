{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Expo: Start (LAN)",
      "type": "shell",
      "command": "npx expo start --lan --clear",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "TypeScript: Check",
      "type": "shell",
      "command": "npm run typecheck",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$tsc"
    },
    {
      "label": "ESLint: Check",
      "type": "shell",
      "command": "npm run lint",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Expo: Doctor",
      "type": "shell",
      "command": "npx expo-doctor",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
