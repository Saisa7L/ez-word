{
  "expo": {
    "name": "易词通",
    "slug": "vocab-app",
    "scheme": "vocabapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#EDF9FF",
        "foregroundImage": "./assets/app/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 App 访问相册以选择头像和名片背景。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EDF9FF",
          "image": "./assets/app/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/app/splash-icon.png"
          }
        }
      ]
    ]
  }
}
